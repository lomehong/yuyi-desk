{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuyi Desk",
  "version": "0.1.0",
  "identifier": "io.qianji.yuyi.desk",
  "build": {
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "title": "御驿 Yuyi Desk",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Qianji Yuyi",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
